{
  "kind": "collectionType",
  "collectionName": "projets",
  "info": {
    "singularName": "projet",
    "pluralName": "projets",
    "displayName": "Portfolio — Réalisations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "titre"
    },
    "type": {
      "type": "string"
    },
    "vignette": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "hero_type": {
      "type": "enumeration",
      "enum": [
        "image",
        "video"
      ]
    },
    "hero_media": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "contenu": {
      "type": "dynamiczone",
      "components": [
        "bloc.texte-bloc",
        "bloc.image-bloc",
        "bloc.video-bloc",
        "bloc.galerie-bloc",
        "bloc.citation-bloc",
        "bloc.serie-media"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::categorie-portfolio.categorie-portfolio"
    }
  }
}
